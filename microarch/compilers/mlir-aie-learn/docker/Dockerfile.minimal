FROM ubuntu:24.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install basic system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    clang-14 \
    lld \
    lld-14 \
    cmake \
    ninja-build \
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    git \
    wget \
    curl \
    libopencv-dev \
    python3-opencv \
    libffi-dev \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libxml2-dev \
    libxmlsec1-dev \
    liblzma-dev \
    gcc-13 \
    g++-13 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Create mlir-aie user
RUN useradd -m -s /bin/bash mlir-aie && \
    usermod -aG sudo mlir-aie && \
    echo "mlir-aie ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to mlir-aie user
USER mlir-aie
WORKDIR /home/mlir-aie

# Default command
CMD ["/bin/bash"]
